# 이 파일을 .env.local로 복사한 뒤 실제 값을 채워넣으세요. (.env.local은 git에 커밋되지 않습니다)

# Supabase 프로젝트 설정 > Database에서 확인 (Connection string - URI)
# 반드시 "Session" 모드(포트 5432)를 사용할 것. "Transaction" 모드(포트 6543)는 prepared
# statement/advisory lock을 지원하지 않아 `prisma migrate dev`가 무한 대기에 빠진다.
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# Supabase 프로젝트 설정 > API Keys에서 확인 (1.2 인증 단계에서 사용)
# anon key는 Supabase가 2026년에 Publishable key로 이름을 바꿨습니다 - 같은 역할, sb_publishable_로 시작
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase 프로젝트 설정 > API Keys > service_role에서 확인 (V2 공개 API용).
# RLS를 완전히 무시하므로 절대 클라이언트로 보내지 말고 서버 코드에서만 써야 한다
# (src/lib/supabase/service.ts가 유일한 사용처). 새 계정 가입이 필요한 게 아니라
# 이미 있는 프로젝트에서 값만 복사해오면 된다.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe 대시보드(https://dashboard.stripe.com) > Developers > API keys에서 확인
# (ROADMAP 2.2). 테스트 모드 키(sk_test_...)로 먼저 연결해보고, 실제로 받을 준비가
# 되면 라이브 키(sk_live_...)로 바꾼다.
STRIPE_SECRET_KEY=""

# Stripe 대시보드 > Products에서 Starter($9/월)와 Pro($29/월) 두 개를 만들고, 각각의
# 월간 구독 Price(반복 결제)를 만들어서 그 Price ID(price_...)를 여기 넣는다.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Stripe 대시보드 > Developers > Webhooks에서 엔드포인트(.../api/webhooks/stripe) 등록 후
# 나오는 서명 시크릿(whsec_...). 로컬 개발 중에는 `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` (Stripe CLI)로 받는 값을 대신 써도 된다.
STRIPE_WEBHOOK_SECRET=""

# 포트원(admin.portone.io) — 한국 사업자는 Stripe 직접 가입이 안 돼서 이걸로 대체했다.
# "결제 연동 > 채널 관리"에서 만든 채널 상세에 Store ID/Channel Key가 있고,
# "결제 연동 > 식별코드·API Keys"에서 API Secret을 발급받는다. Store ID/Channel Key는
# 브라우저 위젯(카드 등록)에서도 그대로 쓰이는 값이라 NEXT_PUBLIC_로 노출해도 안전하다
# (실제 인증은 API Secret이 담당). 실연동 전엔 "테스트" 모드 채널 값을 쓰면 된다.
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""
PORTONE_API_SECRET=""
