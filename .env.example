# 이 파일을 .env.local로 복사한 뒤 실제 값을 채워넣으세요. (.env.local은 git에 커밋되지 않습니다)

# Supabase 프로젝트 설정 > Database에서 확인 (Connection string - URI, "Transaction" 모드 권장)
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# Supabase 프로젝트 설정 > API에서 확인 (1.2 인증 단계에서 사용)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
