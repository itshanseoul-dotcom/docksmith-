# 이 파일을 .env.local로 복사한 뒤 실제 값을 채워넣으세요. (.env.local은 git에 커밋되지 않습니다)

# Supabase 프로젝트 설정 > Database에서 확인 (Connection string - URI)
# 반드시 "Session" 모드(포트 5432)를 사용할 것. "Transaction" 모드(포트 6543)는 prepared
# statement/advisory lock을 지원하지 않아 `prisma migrate dev`가 무한 대기에 빠진다.
DATABASE_URL="postgresql://user:password@localhost:5432/db"

# Supabase 프로젝트 설정 > API Keys에서 확인 (1.2 인증 단계에서 사용)
# anon key는 Supabase가 2026년에 Publishable key로 이름을 바꿨습니다 - 같은 역할, sb_publishable_로 시작
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
