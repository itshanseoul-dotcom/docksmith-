// Docksmith — MVP 데이터 모델
// 팀/권한/구독 테이블은 아직 만들지 않는다 (ROADMAP.md Beta/V1 단계에서 추가)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  CURRENCY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

// MVP는 1 조직 = 1 사용자였지만(ownerAuthUserId), V1부터는 Membership이 "이 사용자가
// 지금 속한 org"의 실제 소스다. 한 사용자는 항상 정확히 하나의 org에만 속한다(초대를
// 수락하면 Membership.organizationId가 새 org로 옮겨갈 뿐, 이전 org는 그대로 남는다 —
// 다시 초대받거나 로그인 시 자기 org로 복귀할 수 있다).
model Organization {
  id              String                 @id @default(cuid())
  name            String
  ownerAuthUserId String                 @unique
  createdAt       DateTime               @default(now())
  templates       Template[]
  memberships     Membership[]
  invites         OrganizationInvite[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  authUserId     String         @unique
  email          String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@map("memberships")
}

// 이메일 발송 없이 링크 공유로 초대한다 — token이 그 자체로 초대 비밀값이다.
model OrganizationInvite {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           MembershipRole @default(MEMBER)
  token          String         @unique
  createdAt      DateTime       @default(now())
  acceptedAt     DateTime?

  @@index([organizationId])
  @@map("organization_invites")
}

model Template {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  category       String?
  sourceFileUrl  String
  pageCount      Int             @default(1)
  fields         TemplateField[]
  fieldVersions  TemplateFieldVersion[]
  jobs           GenerationJob[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@map("templates")
}

// 매핑 스튜디오에서 클릭으로 지정한 필드 하나 = 한 행.
// x/y/width/height는 PDF 페이지 좌표계 기준(pdf-lib 단위와 동일하게 저장).
model TemplateField {
  id         String    @id @default(cuid())
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  key        String
  label      String
  type       FieldType @default(TEXT)
  page       Int       @default(1)
  x          Float
  y          Float
  width      Float
  height     Float
  fontSize   Float     @default(10)
  fixedValue String?

  @@unique([templateId, key])
  @@map("template_fields")
}

// 매핑 저장할 때마다 그 시점의 필드 전체를 스냅샷으로 남긴다. 실수로 매핑을 잘못
// 고쳐도 이전 저장 시점으로 되돌릴 수 있어야 실무에서 믿고 쓸 수 있다(ROADMAP V1).
model TemplateFieldVersion {
  id         String   @id @default(cuid())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  fields     Json
  createdAt  DateTime @default(now())

  @@index([templateId])
  @@map("template_field_versions")
}

// 생성된 PDF 파일 자체는 저장하지 않는다 — 브라우저에서 생성 즉시 다운로드되므로
// 여기 남는 건 "몇 건을 언제 처리했는지"에 대한 기록뿐이다.
model GenerationJob {
  id             String              @id @default(cuid())
  template       Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId     String
  sourceFileName String
  rowCount       Int
  status         JobStatus           @default(PENDING)
  createdAt      DateTime            @default(now())
  items          GenerationJobItem[]

  @@index([templateId])
  @@map("generation_jobs")
}

model GenerationJobItem {
  id           String        @id @default(cuid())
  job          GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  rowIndex     Int
  rowData      Json
  status       JobStatus     @default(PENDING)
  errorMessage String?

  @@index([jobId])
  @@map("generation_job_items")
}

// CSV 컬럼명 ↔ 필드 key 자동 매칭용 동의어 딕셔너리 (PRD 2.2)
model ColumnAlias {
  id           String @id @default(cuid())
  canonicalKey String
  alias        String @unique

  @@index([canonicalKey])
  @@map("column_alias_dictionary")
}
