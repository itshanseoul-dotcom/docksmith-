// Docksmith — MVP 데이터 모델
// 팀/권한/구독 테이블은 아직 만들지 않는다 (ROADMAP.md Beta/V1 단계에서 추가)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  CURRENCY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum TemplateFileType {
  PDF
  DOCX
  XLSX
}

// MVP는 1 조직 = 1 사용자였지만(ownerAuthUserId), V1부터는 Membership이 "이 사용자가
// 지금 속한 org"의 실제 소스다. 한 사용자는 항상 정확히 하나의 org에만 속한다(초대를
// 수락하면 Membership.organizationId가 새 org로 옮겨갈 뿐, 이전 org는 그대로 남는다 —
// 다시 초대받거나 로그인 시 자기 org로 복귀할 수 있다).
model Organization {
  id              String               @id @default(cuid())
  name            String
  ownerAuthUserId String               @unique
  createdAt       DateTime             @default(now())
  templates       Template[]
  memberships     Membership[]
  invites         OrganizationInvite[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]

  @@map("organizations")
}

model Membership {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  authUserId     String         @unique
  email          String
  role           MembershipRole @default(OWNER)
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@map("memberships")
}

// 이메일 발송 없이 링크 공유로 초대한다 — token이 그 자체로 초대 비밀값이다.
model OrganizationInvite {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           MembershipRole @default(MEMBER)
  token          String         @unique
  createdAt      DateTime       @default(now())
  acceptedAt     DateTime?

  @@index([organizationId])
  @@map("organization_invites")
}

// 평문 키는 절대 저장하지 않는다 — 발급 시 한 번만 보여주고 이후로는 keyHash로만
// 대조한다. keyPrefix는 목록 화면에서 "어느 키인지" 구분하는 용도(비밀 아님).
model ApiKey {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  keyPrefix      String
  keyHash        String       @unique
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
  @@map("api_keys")
}

// secret은 API 키와 달리 평문으로 계속 보여준다 — 받는 쪽(Zapier/Make 등)이 서명을
// 검증하려면 이 값을 알아야 하기 때문이다. Docksmith 자체 인증 정보가 아니라
// "우리가 보낸 요청이 맞는지 상대가 확인하는 값"이라 API 키만큼 위험하지 않다.
model Webhook {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  url             String
  secret          String
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  lastTriggeredAt DateTime?
  lastStatus      Int?

  @@index([organizationId])
  @@map("webhooks")
}

model Template {
  id             String                 @id @default(cuid())
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  category       String?
  sourceFileUrl  String
  fileType       TemplateFileType       @default(PDF)
  pageCount      Int                    @default(1)
  fields         TemplateField[]
  fieldVersions  TemplateFieldVersion[]
  jobs           GenerationJob[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId])
  @@map("templates")
}

// 매핑 스튜디오에서 클릭으로 지정한 필드 하나 = 한 행. x/y/width/height는 PDF 페이지
// 좌표계 기준(pdf-lib 단위와 동일하게 저장) — PDF 템플릿에만 쓰이고, DOCX/XLSX는
// 문서 안의 {태그} 텍스트로 위치를 대신하므로 좌표가 없다(전부 null).
model TemplateField {
  id         String    @id @default(cuid())
  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  key        String
  label      String
  type       FieldType @default(TEXT)
  page       Int       @default(1)
  x          Float?
  y          Float?
  width      Float?
  height     Float?
  fontSize   Float     @default(10)
  fixedValue String?

  @@unique([templateId, key])
  @@map("template_fields")
}

// 매핑 저장할 때마다 그 시점의 필드 전체를 스냅샷으로 남긴다. 실수로 매핑을 잘못
// 고쳐도 이전 저장 시점으로 되돌릴 수 있어야 실무에서 믿고 쓸 수 있다(ROADMAP V1).
model TemplateFieldVersion {
  id         String   @id @default(cuid())
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  fields     Json
  createdAt  DateTime @default(now())

  @@index([templateId])
  @@map("template_field_versions")
}

// 생성된 PDF 파일 자체는 저장하지 않는다 — 브라우저에서 생성 즉시 다운로드되므로
// 여기 남는 건 "몇 건을 언제 처리했는지"에 대한 기록뿐이다.
model GenerationJob {
  id             String              @id @default(cuid())
  template       Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId     String
  sourceFileName String
  rowCount       Int
  status         JobStatus           @default(PENDING)
  createdAt      DateTime            @default(now())
  items          GenerationJobItem[]

  @@index([templateId])
  @@map("generation_jobs")
}

model GenerationJobItem {
  id           String        @id @default(cuid())
  job          GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  rowIndex     Int
  rowData      Json
  status       JobStatus     @default(PENDING)
  errorMessage String?

  @@index([jobId])
  @@map("generation_job_items")
}

// CSV 컬럼명 ↔ 필드 key 자동 매칭용 동의어 딕셔너리 (PRD 2.2)
model ColumnAlias {
  id           String @id @default(cuid())
  canonicalKey String
  alias        String @unique

  @@index([canonicalKey])
  @@map("column_alias_dictionary")
}
